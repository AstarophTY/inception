listen=YES
listen_ipv6=NO
anonymous_enable=NO
local_enable=YES
write_enable=YES
local_umask=022
chroot_local_user=YES
allow_writeable_chroot=YES
secure_chroot_dir=/var/run/vsftpd/empty
pam_service_name=vsftpd
xferlog_enable=YES
pasv_enable=YES
pasv_min_port=30000
pasv_max_port=30009
pasv_address=${FTP_PASV_ADDRESS}
user_sub_token=$USER
local_root=/var/www/html
